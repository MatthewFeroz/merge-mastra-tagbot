# Model (any Mastra model string) and its provider key.
MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Merge Agent Handler. Leave blank for a dry run (the bot decides and replies, but no apps are touched).
# Tool Pack: google_calendar__create_event, notion__create_page, slack__post_message
AGENT_HANDLER_API_KEY=
AGENT_HANDLER_TOOL_PACK_ID=
AGENT_HANDLER_REGISTERED_USER_ID=

# Where the demo's actions land.
DEMO_TIMEZONE=America/New_York
DEMO_NOTION_PAGE_ID=
DEMO_SLACK_CHANNEL_ID=

# Optional, for later. With these set the same bot also answers real mentions on X.
X_CONSUMER_SECRET=
X_USER_ACCESS_TOKEN=

DATABASE_URL=file:./tagbot.db
