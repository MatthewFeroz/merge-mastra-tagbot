# Model, routed through Merge Gateway. Any Mastra model string works if you swap the key.
MODEL=merge-gateway/anthropic/claude-sonnet-4-6
MERGE_GATEWAY_API_KEY=

# Merge Agent Handler. Required for real X issue requests.
# Tool Pack: github__create_issue
AGENT_HANDLER_API_KEY=
AGENT_HANDLER_TOOL_PACK_ID=
AGENT_HANDLER_REGISTERED_USER_ID=
GITHUB_OWNER=
GITHUB_REPO=
# CLI demo/Studio stays dry-run by default, even with credentials.
# Set true only when you intend those calls to create real issues.
DEMO_LIVE_ACTIONS=false

# Optional. With these set, the same agent answers real mentions on X.
# X_BOT_USERNAME is the bot's handle without the @. X_CONSUMER_SECRET is the app's API Key Secret. Run `npm run x-auth` to fill in the tokens.
X_BOT_USERNAME=mergeapibot
X_CONSUMER_SECRET=
X_CONSUMER_KEY=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_USER_ACCESS_TOKEN=
X_REFRESH_TOKEN=
# Required for managed refresh. Generate with: openssl rand -base64 32.
# Encrypts rotated OAuth tokens in persistent storage; keep it across deployments.
X_ENCRYPTION_KEY=

DATABASE_URL=file:./tagbot.db
# Use a persistent LibSQL database for hosting; do not use ephemeral file storage.
DATABASE_AUTH_TOKEN=

# Protects the administrative APIs and the live request feed at /api/demo/runs.
# Paste this token only into the /demo page's Connect live dialog.
TAGBOT_API_TOKEN=

# Spam limits (optional, these are the defaults). Over the issue limits the bot replies politely
# and opens nothing. Past the mention limit it stays silent.
TAGBOT_ISSUES_PER_AUTHOR_PER_HOUR=3
TAGBOT_ISSUES_PER_DAY=25
TAGBOT_MENTIONS_PER_AUTHOR_PER_HOUR=10
